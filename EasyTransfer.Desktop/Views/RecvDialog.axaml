<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:EasyTransfer.Desktop.ViewModels"
            xmlns:views="using:EasyTransfer.Desktop.Views"
            x:Class="EasyTransfer.Desktop.Views.RecvDialog"
            x:DataType="vm:MainViewModel"
            x:Name="root"
            Width="580"
            HorizontalAlignment="Center" VerticalAlignment="Center">

    <Border Classes="panel" CornerRadius="24" Background="{DynamicResource SurfaceBrush}"
            BoxShadow="{DynamicResource DialogShadow}">
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="24,22,16,6">
                <Border Grid.Column="0" Classes="badge recv">
                    <Viewbox Width="20" Height="20">
                        <Path Classes="icon" Data="{StaticResource IconRecv}" Stroke="#04130F" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="heading" Text="Receive files" />
                    <TextBlock Classes="sub" Text="Connect to a sender and choose where files are saved" />
                </StackPanel>
                <Button Grid.Column="2" Classes="btn ghost" VerticalAlignment="Top"
                        Command="{Binding CloseSendRecvDialogCommand}">
                    <Viewbox Width="18" Height="18">
                        <Path Classes="icon muted" Data="{StaticResource IconClose}" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,16,24,8" Spacing="20">
                <Grid ColumnDefinitions="*, 12, 120">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="Sender address" />
                        <TextBox Classes="field recv" Name="AddressInput"
                                 PlaceholderText="The server IP Address" AcceptsReturn="False"
                                 AcceptsTab="False" MaxLength="15" Text="{Binding Address, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="Port" />
                        <TextBox Classes="field recv" Name="PortInput"
                                 PlaceholderText="The server port" AcceptsReturn="False"
                                 AcceptsTab="False" MaxLength="5" Text="{Binding Port, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!-- Destination folder -->
                <StackPanel>
                    <TextBlock Classes="label" Text="Save to" />
                    <Grid ColumnDefinitions="*, 10, Auto">
                        <Border Grid.Column="0" MinHeight="44" CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource FieldBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}">
                            <Grid ColumnDefinitions="Auto, *" Margin="14,0">
                                <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0">
                                    <Path Classes="icon recv" Data="{StaticResource IconFolder}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding DestDirectory.FullPath}"
                                           IsVisible="{Binding DestDirectory, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           Text="Choose a destination folder"
                                           IsVisible="{Binding DestDirectory, Converter={x:Static ObjectConverters.IsNull}}" />
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" Classes="btn secondary" Command="{Binding PickDirectoryDialog}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="16" Height="16">
                                    <Path Classes="icon" Data="{StaticResource IconFolder}" />
                                </Viewbox>
                                <TextBlock Text="Browse" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Incoming files -->
                <StackPanel>
                    <TextBlock Classes="label" Text="Incoming files" />
                    <Border Height="120" CornerRadius="14" ClipToBounds="True" BorderThickness="1"
                            Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}">
                        <Grid>
                            <ListBox Classes="list" SelectionMode="Single"
                                     ItemsSource="{Binding FileListDialog, Mode=OneWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, *" Margin="10,8">
                                            <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,12,0">
                                                <Path Classes="icon recv" Data="{StaticResource IconFile}" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="{Binding FullPath, Mode=OneWay}" FontSize="14"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding !FileListDialog.Count}">
                                <Viewbox Width="26" Height="26">
                                    <Path Classes="icon faint" Data="{StaticResource IconTray}" />
                                </Viewbox>
                                <TextBlock Classes="faint" Text="Files will appear here" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Transfer progress (bound to Progress, assumed 0-100) -->
                <StackPanel Spacing="8" IsVisible="{Binding !!Progress}">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Classes="label" Text="Progress" Margin="2,0,0,0" />
                        <TextBlock Grid.Column="1" Classes="label" Margin="0"
                                   Text="{Binding Progress, StringFormat='{}{0}%'}" />
                    </Grid>
                    <ProgressBar Classes="xfer recv" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" Margin="24,12,24,24">
                <Button Grid.Column="1" Classes="btn ghost" Width="NaN" Padding="18,0" Margin="0,0,8,0"
                        Command="{Binding CloseSendRecvDialogCommand}">
                    <TextBlock Text="Cancel" FontSize="14" FontWeight="SemiBold" />
                </Button>
                <Button Grid.Column="2" Classes="btn primary recv"
                        Command="{Binding StartReceivingCommand}" CommandParameter="{Binding $self}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="18" Height="18">
                            <Path Classes="icon" Data="{StaticResource IconRecv}" Stroke="#04130F" />
                        </Viewbox>
                        <TextBlock Text="Receive" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
