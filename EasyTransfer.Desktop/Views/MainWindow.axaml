<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EasyTransfer.Desktop.ViewModels"
        xmlns:views="using:EasyTransfer.Desktop.Views"
        x:Class="EasyTransfer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="root"
        Title="EasyTransfer">

    <Window.Styles>
        <Style Selector="Button.Send">
            <Setter Property="Background" Value="Blue"/>
        </Style>

        <Style Selector="Button.Recv">
            <Setter Property="Background" Value="Red"/>
        </Style>

        <Style Selector="Window#root">
            <Setter Property="Background" Value="#212121"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid ColumnDefinitions="*" RowDefinitions="*, *">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Classes="Send" Command="{Binding ShowSendDialogCommand}" Width="200" Height="100" Margin="4" CornerRadius="4">
                    <Image Source="/Assets/Arrow.png" />
                </Button>
                <Button Classes="Recv" Command="{Binding ShowRecvDialogCommand}" Width="200" Height="100" Margin="4" CornerRadius="4">
                    <Image Source="/Assets/Arrow.png">
                        <Image.RenderTransform>
                            <RotateTransform Angle="180" />
                        </Image.RenderTransform>
                    </Image>
                </Button>
            </StackPanel>
            <ListBox Grid.Row="1" Background="Transparent" SelectionMode="Single" ItemsSource="{Binding HistoryTransfer}" >
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Margin" Value="8 1.2" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4 8" BorderBrush="White" BorderThickness="2">
                            <TextBlock Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        
        <Border Background="Black" Opacity="0.5" IsVisible="{Binding IsSendRecvDialogOpen, Mode=OneWay}" />
        <views:SendDialog IsVisible="{Binding IsSendDialog}" />
        <views:RecvDialog IsVisible="{Binding IsRecvDialog}" />
    </Grid>
</Window>
