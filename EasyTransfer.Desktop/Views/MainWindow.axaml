<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EasyTransfer.Desktop.ViewModels"
        xmlns:views="using:EasyTransfer.Desktop.Views"
        x:Class="EasyTransfer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="root"
        Title="EasyTransfer"
        Width="920" Height="680"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Grid>
        <!-- Ambient glow -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0%,0%" GradientOrigin="0%,0%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Color="#2A6366F1" Offset="0" />
                    <GradientStop Color="#006366F1" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Color="#2010B981" Offset="0" />
                    <GradientStop Color="#0010B981" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="44,36,44,36" RowDefinitions="Auto, Auto, *">

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource SendGradient}">
                    <Viewbox Width="24" Height="24">
                        <Path Classes="icon" Data="{StaticResource IconSwap}" Stroke="White" />
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="title" Text="EasyTransfer" />
                    <TextBlock Classes="sub" Text="Move files between devices on your network" />
                </StackPanel>
            </StackPanel>

            <!-- Action cards -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,32,0,0">
                <Button Grid.Column="0" Classes="btn card" Margin="0,0,9,0"
                        Command="{Binding ShowSendDialogCommand}">
                    <Border Classes="cardface send" Height="190">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Classes="badge send" Width="52" Height="52" CornerRadius="16">
                                    <Viewbox Width="26" Height="26">
                                        <Path Classes="icon" Data="{StaticResource IconSend}" Stroke="White" />
                                    </Viewbox>
                                </Border>
                                <Viewbox Grid.Column="2" Width="22" Height="22" VerticalAlignment="Top">
                                    <Path Classes="icon faint" Data="{StaticResource IconArrowUpRight}" />
                                </Viewbox>
                            </Grid>
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="4">
                                <TextBlock Classes="heading" Text="Send" FontSize="22" />
                                <TextBlock Classes="sub" Text="Pick files and send them to another device." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>

                <Button Grid.Column="1" Classes="btn card" Margin="9,0,0,0"
                        Command="{Binding ShowRecvDialogCommand}">
                    <Border Classes="cardface recv" Height="190">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Classes="badge recv" Width="52" Height="52" CornerRadius="16">
                                    <Viewbox Width="26" Height="26">
                                        <Path Classes="icon" Data="{StaticResource IconRecv}" Stroke="#04130F" />
                                    </Viewbox>
                                </Border>
                                <Viewbox Grid.Column="2" Width="22" Height="22" VerticalAlignment="Top">
                                    <Path Classes="icon faint" Data="{StaticResource IconArrowUpRight}" />
                                </Viewbox>
                            </Grid>
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="4">
                                <TextBlock Classes="heading" Text="Receive" FontSize="22" />
                                <TextBlock Classes="sub" Text="Connect to a sender and save files to a folder." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
            </Grid>

            <!-- History -->
            <Grid Grid.Row="2" Margin="0,34,0,0" RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="18" Height="18">
                        <Path Classes="icon muted" Data="{StaticResource IconClock}" />
                    </Viewbox>
                    <TextBlock Classes="section" Text="Recent transfers" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1" Classes="panel" Margin="0,12,0,0">
                    <Grid>
                        <ListBox Classes="list" SelectionMode="Single" ItemsSource="{Binding HistoryTransfer}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *" Margin="12,10">
                                        <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,12,0">
                                            <Path Classes="icon send" Data="{StaticResource IconCheck}" />
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsHitTestVisible="False"
                                    IsVisible="{Binding !HistoryTransfer.Count}">
                            <Viewbox Width="34" Height="34">
                                <Path Classes="icon faint" Data="{StaticResource IconTray}" />
                            </Viewbox>
                            <TextBlock Text="No transfers yet" HorizontalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Classes="faint" Text="Completed transfers will show up here."
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Dialog layer -->
        <Border Background="{DynamicResource ScrimBrush}" IsVisible="{Binding IsSendRecvDialogOpen, Mode=OneWay}" />
        <views:SendDialog IsVisible="{Binding IsSendDialog}" />
        <views:RecvDialog IsVisible="{Binding IsRecvDialog}" />
    </Grid>
</Window>
